---
import Base from '../layouts/Base.astro'
---

<Base title="Not found" description="This page didn't make the final cut.">
  <section class="wrap lost">
    <p class="label">404 · Deleted scene</p>
    <h1 class="display">This page didn't make the final cut.</h1>
    <a class="btn btn-primary" href="/">Back to the main feature</a>
  </section>
</Base>

<style>
  .lost {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
    padding-top: 120px;
    padding-bottom: 120px;
  }
  h1 {
    font-size: clamp(44px, 7vw, 88px);
    line-height: 0.95;
  }
</style>
