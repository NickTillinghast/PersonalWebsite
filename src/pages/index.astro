---
import Base from '../layouts/Base.astro'
import PosterCard from '../components/PosterCard.astro'
import { about, contact, hero, offTheClock, person, projects } from '../content'
---

<Base>
  <div class="wrap">
    <section id="top" class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="label eyebrow">Now showing</p>
        <h1 id="hero-title" class="display hero-title">
          Full-stack developer.<br />Horror fan.<br />
          <span class="red">Ships things that go bump in production.</span>
        </h1>
        <p class="hero-intro">{hero.intro} {hero.work}</p>
        <div class="actions">
          <a class="btn btn-primary" href="#work">See the work</a>
          <a class="btn" href="#contact">Get in touch</a>
        </div>
      </div>
      <dl class="credits glow" aria-label="Credits">
        {
          hero.credits.map((c) => (
            <>
              <dt>{c.label}</dt>
              <dd>{c.value}</dd>
            </>
          ))
        }
      </dl>
    </section>

    <section id="work" class="section" aria-labelledby="work-title">
      <div class="section-head">
        <h2 id="work-title" class="display h2">Feature presentations</h2>
        <p class="mono-note">{projects.length} titles · runtime varies</p>
      </div>
      <div class="grid-3">
        {projects.map((project, i) => <PosterCard project={project} number={i + 1} />)}
      </div>
    </section>

    <section id="about" class="section" aria-labelledby="about-title">
      <div class="grid-2">
        <h2 id="about-title" class="display h2">The making-of</h2>
        <div class="prose">
          {about.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <section id="off" class="section" aria-labelledby="off-title">
      <h2 id="off-title" class="display h2 off-title">After the credits</h2>
      <div class="grid-3">
        {
          offTheClock.map((item) => (
            <div class="tile glow">
              <p class="label">{item.label}</p>
              <p class="tile-title">{item.title}</p>
              <p class="tile-note">{item.note}</p>
            </div>
          ))
        }
      </div>
    </section>

    <footer id="contact" class="section contact" aria-labelledby="contact-title">
      <p class="label eyebrow">Post-credits scene</p>
      <h2 id="contact-title" class="display contact-title">
        {contact.heading[0]}<br />{contact.heading[1]}
      </h2>
      {
        person.email ? (
          <a class="email" href={`mailto:${person.email}`}>{person.email}</a>
        ) : (
          <p class="email placeholder">[YOUR EMAIL]</p>
        )
      }
      <ul class="socials">
        {
          contact.socials.map((s) =>
            s.href ? (
              <li>
                <a href={s.href} rel="noopener">{s.label}</a>
              </li>
            ) : (
              <li class="placeholder">{s.label} [URL]</li>
            ),
          )
        }
      </ul>
    </footer>
  </div>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 56px;
    align-items: end;
    padding: 60px 0 96px;
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .eyebrow {
    font-size: 13px;
    letter-spacing: 0.2em;
  }
  .hero-title {
    font-size: clamp(48px, 8vw, 104px);
    line-height: 0.95;
    letter-spacing: 0.01em;
  }
  .red {
    color: var(--red);
  }
  .hero-intro {
    margin: 0;
    max-width: 560px;
    font-size: 19px;
    line-height: 1.6;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .credits {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px 24px;
    margin: 0;
    padding: 28px;
    border: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 14px;
  }
  .credits dt {
    color: var(--dim);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .credits dd {
    margin: 0;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 40px;
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-size: 18px;
    line-height: 1.7;
    color: var(--text-soft);
  }
  .prose p {
    margin: 0;
  }

  .off-title {
    margin-bottom: 40px;
  }
  .tile {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
    border: 1px solid var(--border);
  }
  .tile p {
    margin: 0;
  }
  .tile-title {
    font-size: 22px;
    font-weight: 600;
  }
  .tile-note {
    font-size: 15px;
    color: var(--muted);
  }

  .contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding: 96px 0 120px;
    text-align: center;
  }
  .contact-title {
    font-size: clamp(40px, 6vw, 80px);
  }
  .email {
    margin: 0;
    font-size: 22px;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 28px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 40px;
      padding: 64px 0 72px;
    }
    .credits {
      padding: 20px;
      gap: 12px 16px;
      font-size: 13px;
    }
    .contact {
      padding: 72px 0 96px;
    }
  }
</style>
